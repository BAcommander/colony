        "sha256": "95fe61443b4693820ae067169e10ad0d4b6994a2f7ede3a47596a35ca432ceaf",
        "voice": "Microsoft George",
        "rate": 0,
        "text": "Vesha nara, sovek talun. Kesh varo, nesh tavan."
      },
      {
        "file": "voice-02.wav",
        "sha256": "a8d905c4bbd01e5e0a9bb0ec5a1680764fd0a6fbec48b13fa2e74e0bef65af71",
        "voice": "Microsoft Hazel Desktop",
        "rate": 0,
        "text": "Sha veran. Talo nesh, mena darok. Vesh taren."
      },
      {
        "file": "voice-03.wav",
        "sha256": "48991371b8b69e52f908f78886f792f544dd35311a55c64589d7d9650a7fdfe8",
        "voice": "Microsoft George",
        "rate": 1,
        "text": "Nera. Kesh valun, shora ven. Daro sovek talan."
      },
      {
        "file": "voice-04.wav",
        "sha256": "935a8dfb2ccee6514a57ab4e9b643c6bb4d4a1b048ac461131975717a5745510",
        "voice": "Microsoft Hazel Desktop",
        "rate": -1,
        "text": "Sova kesh. Vena shoran, tavi melun. Nesh varo."
      },
      {
        "file": "voice-05.wav",
        "sha256": "e04c5b404430f84ec50a96105a277ba8d00a5917e371ddcadaf4a3b7ad610047",
        "voice": "Microsoft George",
        "rate": -1,
        "text": "Talan veresh, nora shan. Vesha valun."
      },
      {
        "file": "voice-06.wav",
        "sha256": "a8f6d7416e755b6ee38509695c43666cb31b0f84a16dd8f740aecc93ca06de60",
        "voice": "Microsoft Hazel Desktop",
        "rate": 1,
        "text": "Kora nesh, taven saro. Mena, sha vesh."
      },
      {
        "sha256": "99d6fd113adc8aa969a2fa3d34e583eabf1af31b4159c4b0bc743c93bd565ad8",
        "voice": "Microsoft George",
        "rate": 0,
        "text": "Shava nesh. Doran vela, sevan torak. Nesh valun.",
        "file": "voice-07.wav"
      },
      {
        "sha256": "50122ce0a2002f055964465caf12d6aef6dbdae6832948cef9aa990288e80a91",
        "voice": "Microsoft Hazel Desktop",
        "rate": 1,
        "text": "Mera shovan. Kela nesh, tora van. Vesh dalun.",
        "file": "voice-08.wav"
      },
      {
        "sha256": "ace716c7071e2b7faea09102fa3a3ba33fb74fe28a055f766124ec14131b1fee",
        "voice": "Microsoft George",
        "rate": -1,
        "text": "Kesh varena. Dalan shora, navik tal. Sovan nesh.",
        "file": "voice-09.wav"
      },
      {
        "sha256": "d4e1a26c2799aa69ee7290fc8198e4d207a834b17c503a3dbf58143c9344d8eb",
        "voice": "Microsoft Hazel Desktop",
        "rate": 0,
        "text": "Talun vera, shen malok. Nara vesh. Sela tavan.",
        "file": "voice-10.wav"
      },
      {
        "sha256": "7bc2a7049c1317cefa880a9caf963bb5bb5c0d886d7b1932ea965dea4950e5d8",
        "voice": "Microsoft George",
        "rate": 1,
        "text": "Saro nesh, kelan voru. Sha daren. Nesh valok.",
        "file": "voice-11.wav"
      },
      {
        "sha256": "63e5baf3b9073e2ec743461e78c8a2302698353617c714a949924ed1f7abd9a7",
        "voice": "Microsoft Hazel Desktop",
        "rate": -1,
        "text": "Vena shalun. Meran tora, kesh valen. Shora ven.",
        "file": "voice-12.wav"
      },
      {
        "sha256": "aca8a2300fc73dea5218b7feefdfac36e61d108996fd87655246772242bd4bf9",
        "voice": "Microsoft George",
        "rate": 0,
        "text": "Daro shen. Velan kora, nesh tavi. Sovan taro.",
        "file": "voice-13.wav"
      },
      {
        "sha256": "638fc6b3545a99a87dcf5b2148587748ca072fe1b5cea380c3a8b233df636c96",
